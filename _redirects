# ============================================================
#  Cloudflare Pages - REDIRECTS (SEM LOOP!)
#  Regra chave: NÃO redirect URLs que JÁ terminam com .html
#  Fallback SPA SOMENTE para ROTAS SEM EXTENSÃO (não captura .js/.css/.html/imagens)
# ============================================================

# --- 1) Autenticação: APENAS rotas SEM extensão .html (URL amigável) ---
# (se o usuário já acessou /auth/register.html direto, NÃO TOCA para não loop)
/auth/register             /auth/register.html          301
/auth/login                /auth/login.html             301
/auth/forgot               /auth/forgot-password.html   301
/auth/reset                /auth/reset-password.html    301
/auth/confirm              /auth/confirm.html           301

# --- 2) Dashboard / Painel (rotas amigáveis para o SPA) ---
/dashboard                 /index.html                  200
/painel                    /index.html                  200
/home                      /index.html                  200

# --- 3) Fallback SPA - SÓ para caminhos sem ponto (extensão) ---
# (evita capturar /auth/register.html, /modules/core/x.js, /styles/a.css, /logo.png etc)
/:page                     /index.html                  200
